<Application x:Class="LucidQueue.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:common="clr-namespace:LucidQueue.Common"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/LucidQueue;component/Styles/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <FontFamily x:Key="AppFont">Segoe UI Variable Text, Microsoft YaHei UI, Microsoft YaHei, Segoe UI</FontFamily>
            <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI Variable Text, Microsoft YaHei UI, Microsoft YaHei, Segoe UI</FontFamily>
            <FontFamily x:Key="IconFont">Segoe MDL2 Assets, Segoe Fluent Icons</FontFamily>
            <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas, Microsoft YaHei UI</FontFamily>

            <common:InverseBoolConverter x:Key="InverseBool" />
            <common:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
            <common:EffectBrushConverter x:Key="EffectBrush" />
            <common:NullToCollapsedConverter x:Key="NullToCollapsed" />
            <common:NotNullToCollapsedConverter x:Key="NotNullToCollapsed" />
            <BooleanToVisibilityConverter x:Key="BoolToVis" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
