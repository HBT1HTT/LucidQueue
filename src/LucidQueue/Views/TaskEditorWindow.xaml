<Window x:Class="LucidQueue.Views.TaskEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="编辑任务" Width="700" Height="780"
        WindowStyle="None" Background="#FF0C0F15"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        FontFamily="{DynamicResource AppFont}">

    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="Margin" Value="0,0,0,7" />
        </Style>

        <Style x:Key="FieldHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="{DynamicResource TextTertiary}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style x:Key="PlainListItem" TargetType="ListBoxItem">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Border CornerRadius="0" BorderThickness="0" BorderBrush="#2AFFFFFF">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#FF131720" Offset="0" />
                    <GradientStop Color="#FF0C0F15" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="52" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="64" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <StackPanel Margin="22,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="WindowTitle" Text="编辑任务" FontSize="13" FontWeight="SemiBold" />
                        <TextBlock x:Name="WindowSubtitle" Text="需要重启就打勾，依赖决定它何时可用。"
                                   FontSize="9.5" Foreground="{DynamicResource TextTertiary}" Margin="0,2,0,0" />
                    </StackPanel>
                    <Button Style="{StaticResource IconButton}" HorizontalAlignment="Right"
                            VerticalAlignment="Center" Margin="0,0,14,0" Click="Cancel_Click" ToolTip="关闭">
                        <TextBlock Text="&#xE8BB;" Style="{StaticResource IconGlyph}" FontSize="11" />
                    </Button>
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="22,4,16,8">
                    <StackPanel>
                        <TextBlock Text="标题" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="TitleBox" FontSize="13" Padding="11,9"
                                 AutomationProperties.Name="编辑任务标题" />

                        <TextBlock Text="备注（可选）" Style="{StaticResource FieldLabel}" Margin="0,16,0,7" />
                        <TextBox x:Name="NotesBox" FontSize="11.5" Padding="11,8" Height="68"
                                 AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" />

                        <TextBlock Text="系统状态" Style="{StaticResource FieldLabel}" Margin="0,18,0,7" />
                        <Border Background="{DynamicResource ControlBg}" BorderBrush="{DynamicResource CardBorder}"
                                BorderThickness="1" CornerRadius="9" Padding="13,11">
                            <StackPanel>
                                <CheckBox x:Name="NeedsRebootBox"
                                          AutomationProperties.Name="需要重启"
                                          FontSize="12" FontWeight="SemiBold"
                                          Content="需要重启才生效" />
                                <TextBlock Text="勾选后，完成这项任务会进入重启批次；不勾选就按常规任务处理。"
                                           Style="{StaticResource FieldHint}" Margin="28,6,0,0" />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="依赖（可选）" Style="{StaticResource FieldLabel}" Margin="0,18,0,7" />
                        <TextBlock Text="勾选表示：当前任务必须等这些任务完成之后，才能打勾。"
                                   Style="{StaticResource FieldHint}" />
                        <Border Background="{DynamicResource PanelBgSoft}" BorderBrush="{DynamicResource CardBorder}"
                                BorderThickness="1" CornerRadius="9" Padding="10">
                            <StackPanel>
                                <ListBox x:Name="DependencyList" Background="Transparent" BorderThickness="0"
                                         MaxHeight="168" ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         ItemContainerStyle="{StaticResource PlainListItem}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="2,5">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Title}" FontSize="11" MaxWidth="420"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Meta}" FontSize="9.5"
                                                               Foreground="{DynamicResource TextTertiary}" Margin="8,1,0,0" />
                                                </StackPanel>
                                            </CheckBox>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock x:Name="EmptyDependencyHint" Text="还没有其他任务可以设为前置。"
                                           Style="{StaticResource FieldHint}" Margin="2,2,0,2" Visibility="Collapsed" />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="自定义参数" Style="{StaticResource FieldLabel}" Margin="0,18,0,7" />
                        <TextBlock Text="给任务附加任意 Key: Value，例如 pagefile: 32768 MB。"
                                   Style="{StaticResource FieldHint}" />
                        <ItemsControl x:Name="ParameterList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="0.42*" />
                                            <ColumnDefinition Width="0.58*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding Key, UpdateSourceTrigger=PropertyChanged}"
                                                 FontSize="11" Padding="9,6" ToolTip="Key" />
                                        <TextBox Grid.Column="1" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                 FontSize="11" Padding="9,6" Margin="6,0,0,0" ToolTip="Value" />
                                        <Button Grid.Column="2" Style="{StaticResource IconButton}" Margin="4,0,0,0"
                                                Tag="{Binding}" Click="RemoveParameter_Click" ToolTip="移除参数">
                                            <TextBlock Text="&#xE711;" Style="{StaticResource IconGlyph}" FontSize="10" />
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Content="+ 添加参数" Style="{StaticResource SubtleButton}"
                                HorizontalAlignment="Left" Margin="0,2,0,0" Click="AddParameter_Click" />

                        <Border Background="{DynamicResource DangerSoft}" BorderBrush="#40F07178"
                                BorderThickness="1" CornerRadius="8" Padding="10,7" Margin="0,14,0,0"
                                x:Name="ErrorBox" Visibility="Collapsed">
                            <TextBlock x:Name="ErrorText" FontSize="10.5" Foreground="{DynamicResource Danger}"
                                       TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <Grid Grid.Row="2">
                    <Border BorderBrush="{DynamicResource Divider}" BorderThickness="0,1,0,0" />
                    <Grid Margin="22,0,22,0">
                        <TextBlock Text="依赖和参数会随任务一起保存。" Style="{StaticResource FieldHint}"
                                   VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Content="取消" Style="{StaticResource GhostButton}" Padding="16,8"
                                    AutomationProperties.Name="取消编辑" Click="Cancel_Click" />
                            <Button x:Name="SaveButton" Content="保存" Style="{StaticResource PrimaryButton}"
                                    Padding="18,8" Margin="8,0,0,0"
                                    AutomationProperties.Name="保存任务" Click="Save_Click" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
