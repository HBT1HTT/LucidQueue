<Window x:Class="LucidQueue.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Lucid Queue"
        Width="1120" Height="780" MinWidth="960" MinHeight="620"
        WindowStyle="None" Background="#FF0A0D12"
        ResizeMode="CanResize" WindowStartupLocation="CenterScreen"
        FontFamily="{DynamicResource AppFont}"
        Loaded="Window_Loaded" Closing="Window_Closing">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6"
                            GlassFrameThickness="0" CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Grid x:Name="Root">
        <Border x:Name="Shell" CornerRadius="0" BorderThickness="0"
                BorderBrush="#2AFFFFFF">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#FF10141B" Offset="0" />
                    <GradientStop Color="#FF0A0C11" Offset="0.55" />
                    <GradientStop Color="#FF0C0F14" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>

            <Grid>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="46" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="29" />
                    </Grid.RowDefinitions>

                    <!-- ===== 标题栏 ===== -->
                    <Grid Grid.Row="0" Background="Transparent"
                          MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                        <StackPanel Orientation="Horizontal" Margin="18,0,0,0" VerticalAlignment="Center">
                            <Border Width="21" Height="21" CornerRadius="6"
                                    Background="{DynamicResource AccentSoft}"
                                    BorderBrush="{DynamicResource AccentBorder}" BorderThickness="1">
                                <TextBlock Text="L" FontSize="10.5" FontWeight="Bold"
                                           Foreground="{DynamicResource Accent}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="LUCID QUEUE" FontSize="10.5" FontWeight="SemiBold"
                                       Foreground="#C6D0DB" Margin="9,1,0,0" VerticalAlignment="Center" />
                            <Border Background="#0AFFFFFF" BorderBrush="{DynamicResource CardBorder}"
                                    BorderThickness="1" CornerRadius="6" Padding="7,2" Margin="12,0,0,0"
                                    VerticalAlignment="Center">
                                <TextBlock Text="MANUAL STATE" FontSize="8.5" Foreground="{DynamicResource TextTertiary}" />
                            </Border>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                    VerticalAlignment="Center" Margin="0,0,9,0">
                            <Button Style="{StaticResource WindowButton}" Click="Minimize_Click"
                                    ToolTip="最小化" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                                <TextBlock Text="&#xE921;" Style="{StaticResource IconGlyph}" FontSize="11" />
                            </Button>
                            <Button Style="{StaticResource CloseWindowButton}" Click="Close_Click"
                                    ToolTip="收进托盘" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                                <TextBlock Text="&#xE8BB;" Style="{StaticResource IconGlyph}" FontSize="11" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- ===== 主体 ===== -->
                    <Grid Grid.Row="1" Margin="20,4,18,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="344" />
                        </Grid.ColumnDefinitions>

                        <!-- 队列 -->
                        <Grid Grid.Column="0" Margin="0,0,18,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="2,6,0,14">
                                <StackPanel>
                                    <TextBlock Text="任务队列" Style="{StaticResource WindowTitle}" />
                                    <TextBlock Text="把需要重启的改动，合并成一批。" Style="{StaticResource MutedText}" Margin="0,2,0,0" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Border Style="{StaticResource StatPill}">
                                        <TextBlock Text="{Binding ActiveSummary}" FontSize="10.5" Foreground="{DynamicResource TextSecondary}" />
                                    </Border>
                                    <Border Style="{StaticResource StatPillAccent}">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="6" Height="6" VerticalAlignment="Center" Margin="0,0,6,0"
                                                     Fill="{Binding PendingIndicatorBrush}"
                                                     Visibility="{Binding HasPending, Converter={StaticResource BoolToVis}}" />
                                            <TextBlock Text="{Binding PendingSummary}" FontSize="10.5" Foreground="{DynamicResource Accent}" />
                                        </StackPanel>
                                    </Border>
                                    <Button Content="{Binding CompletedSummary}" Style="{StaticResource GhostButton}"
                                            Padding="11,4" FontSize="10.5" Margin="8,0,0,0"
                                            Click="Completed_Click" ToolTip="查看已完成记录"
                                            AutomationProperties.Name="查看已完成" />
                                </StackPanel>
                            </Grid>

                            <Border Grid.Row="1" Background="{DynamicResource PanelBgSoft}"
                                    BorderBrush="{DynamicResource CardBorder}" BorderThickness="1"
                                    CornerRadius="10" Padding="8" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="80" />
                                    </Grid.ColumnDefinitions>

                                    <Grid Margin="2,0,10,0">
                                        <TextBox Text="{Binding NewTaskTitle, UpdateSourceTrigger=PropertyChanged}"
                                                 Background="Transparent" BorderThickness="0" Padding="10,7"
                                                 VerticalContentAlignment="Center"
                                                 AutomationProperties.Name="任务标题">
                                            <TextBox.InputBindings>
                                                <KeyBinding Key="Enter" Command="{Binding AddTaskCommand}" />
                                            </TextBox.InputBindings>
                                        </TextBox>
                                        <TextBlock Text="下一件事…（回车加入队列）" FontSize="11.5"
                                                   Foreground="{DynamicResource TextTertiary}"
                                                   Margin="11,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding NewTaskTitle}" Value="">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>

                                    <CheckBox Grid.Column="1" Margin="0,0,12,0" VerticalAlignment="Center"
                                              IsChecked="{Binding NewTaskNeedsReboot, Mode=TwoWay}"
                                              AutomationProperties.Name="需要重启"
                                              ToolTip="勾选表示这条任务要重启一次才会真正生效">
                                        <TextBlock Text="需要重启" FontSize="11.5" Foreground="{DynamicResource RebootText}" />
                                    </CheckBox>

                                    <Button Grid.Column="2" Content="添加" Height="34" Padding="0"
                                            Style="{StaticResource PrimaryButton}"
                                            Command="{Binding AddTaskCommand}"
                                            AutomationProperties.Name="添加任务" />
                                </Grid>
                            </Border>

                            <Grid Grid.Row="2" Margin="0,0,0,8">
                                <ListBox Style="{StaticResource PillListBox}" ItemsSource="{Binding Filters}"
                                         SelectedItem="{Binding SelectedFilter, Mode=TwoWay}"
                                         HorizontalAlignment="Left" VerticalAlignment="Top">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Display}" FontSize="11.5" />
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                            VerticalAlignment="Center" Margin="0,0,4,4">
                                    <TextBlock Text="排序" Style="{StaticResource TinyText}" />
                                    <TextBlock Text="{Binding SortLabel}" FontSize="10.5"
                                               Foreground="{DynamicResource Accent}" Margin="6,0,0,0" />
                                </StackPanel>
                            </Grid>

                            <StackPanel Grid.Row="3">
                                <Border Background="{DynamicResource WarningSoft}"
                                        BorderBrush="{DynamicResource WarningBorder}" BorderThickness="1"
                                        CornerRadius="10" Padding="13,10" Margin="0,0,0,10"
                                        Visibility="{Binding CountdownVisible, Converter={StaticResource BoolToVis}}">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE7BA;" FontFamily="{DynamicResource IconFont}" FontSize="13"
                                                       Foreground="{DynamicResource Warning}" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding CountdownText}" FontSize="11.5"
                                                       Foreground="{DynamicResource Warning}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <Button Content="收起" Style="{StaticResource GhostButton}"
                                                    Padding="10,4" FontSize="11"
                                                    Command="{Binding CancelCountdownCommand}"
                                                    Visibility="{Binding CanCancelCountdown, Converter={StaticResource BoolToVis}}" />
                                            <Button Content="{Binding ManualConfirmText}" Style="{StaticResource PrimaryButton}"
                                                    Padding="11,5" FontSize="11"
                                                    Command="{Binding ConfirmManualCommand}"
                                                    Visibility="{Binding CanConfirmManual, Converter={StaticResource BoolToVis}}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Border Background="{DynamicResource AccentSoft}"
                                        BorderBrush="{DynamicResource AccentBorder}" BorderThickness="1"
                                        CornerRadius="10" Padding="13,11" Margin="0,0,0,10"
                                        Visibility="{Binding ReminderVisible, Converter={StaticResource BoolToVis}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding ReminderTitle}" FontSize="12" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource Accent}" />
                                                <TextBlock Text="{Binding ReminderMeta}" FontSize="10.5"
                                                           Foreground="{DynamicResource TextSecondary}" Margin="8,1,0,0" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding ReminderBody}" FontSize="11.5"
                                                       Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" Margin="0,5,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                                            <Button Content="查看常规任务" Style="{StaticResource GhostButton}"
                                                    Padding="10,5" FontSize="10.5"
                                                    Command="{Binding ShowNormalTasksCommand}" />
                                            <Button Style="{StaticResource IconButton}" Margin="5,0,0,0"
                                                    Command="{Binding DismissReminderCommand}" ToolTip="关闭提示">
                                                <TextBlock Text="&#xE711;" Style="{StaticResource IconGlyph}" FontSize="11" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <Grid Grid.Row="4">
                                <ListBox x:Name="TaskList" ItemsSource="{Binding VisibleTasks}"
                                         Background="Transparent" BorderThickness="0" Padding="0"
                                         ItemContainerStyle="{StaticResource TaskListItem}"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         VirtualizingStackPanel.IsVirtualizing="True"
                                         VirtualizingStackPanel.VirtualizationMode="Recycling"
                                         AutomationProperties.Name="任务列表">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                                <Border Style="{StaticResource TaskCard}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <CheckBox Grid.Column="0" VerticalAlignment="Top"
                                                                  IsChecked="{Binding IsCompleted, Mode=OneWay}"
                                                                  IsEnabled="{Binding IsBlocked, Converter={StaticResource InverseBool}}"
                                                                  Checked="TaskCheck_Toggled" Unchecked="TaskCheck_Toggled"
                                                                  AutomationProperties.Name="切换完成状态"
                                                                  ToolTip="{Binding BlockedByText}"
                                                                  ToolTipService.IsEnabled="{Binding HasBlockedText}">
                                                            <TextBlock Text="已完成" FontSize="10.5"
                                                                       Foreground="{DynamicResource TextSecondary}" />
                                                        </CheckBox>

                                                        <StackPanel Grid.Column="1" Margin="11,0,8,0">
                                                            <TextBlock Text="{Binding Title}" FontSize="13.5" FontWeight="Medium"
                                                                       TextTrimming="CharacterEllipsis" />

                                                            <TextBlock Text="{Binding Notes}" FontSize="10.5"
                                                                       Foreground="{DynamicResource TextSecondary}"
                                                                       TextTrimming="CharacterEllipsis" Margin="0,4,0,0"
                                                                       Visibility="{Binding HasNotes, Converter={StaticResource BoolToVis}}" />

                                                            <WrapPanel Margin="0,7,0,0">
                                                                <ContentControl Style="{StaticResource EffectBadge}"
                                                                                Content="{Binding EffectLabel}"
                                                                                Margin="0,0,6,4"
                                                                                Visibility="{Binding IsPendingEffect, Converter={StaticResource InverseBoolToVis}}" />
                                                                <ContentControl Style="{StaticResource PendingBadge}"
                                                                                Content="{Binding PendingLabel}"
                                                                                Margin="0,0,6,4"
                                                                                Visibility="{Binding IsPendingEffect, Converter={StaticResource BoolToVis}}" />
                                                                <Border Background="#0DFFFFFF"
                                                                        BorderBrush="{DynamicResource CardBorder}"
                                                                        BorderThickness="1" CornerRadius="5"
                                                                        Padding="6,2" Margin="0,0,6,4"
                                                                        Visibility="{Binding HasBlockedText, Converter={StaticResource BoolToVis}}">
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <TextBlock Text="&#xE72E;" FontFamily="{DynamicResource IconFont}"
                                                                                   FontSize="9" Foreground="{DynamicResource TextTertiary}"
                                                                                   VerticalAlignment="Center" />
                                                                        <TextBlock Text="{Binding BlockedByText}" FontSize="10"
                                                                                   Foreground="{DynamicResource TextSecondary}" Margin="5,0,0,0" />
                                                                    </StackPanel>
                                                                </Border>
                                                                <Border Background="#0DFFFFFF"
                                                                        BorderBrush="{DynamicResource CardBorder}"
                                                                        BorderThickness="1" CornerRadius="5"
                                                                        Padding="6,2" Margin="0,0,6,4"
                                                                        Visibility="{Binding HasParameters, Converter={StaticResource BoolToVis}}">
                                                                    <TextBlock Text="{Binding ParameterSummary}" FontSize="10"
                                                                               Foreground="{DynamicResource TextSecondary}" />
                                                                </Border>
                                                            </WrapPanel>

                                                            <TextBlock Text="{Binding DependencySummary}" FontSize="10"
                                                                       Foreground="{DynamicResource TextTertiary}" Margin="0,1,0,0"
                                                                       Visibility="{Binding HasDependencySummary, Converter={StaticResource BoolToVis}}" />
                                                        </StackPanel>

                                                        <Button Grid.Column="2" Style="{StaticResource IconButton}"
                                                                VerticalAlignment="Top" Click="TaskMenu_Click" ToolTip="更多操作"
                                                                AutomationProperties.Name="任务操作">
                                                            <TextBlock Text="&#xE712;" Style="{StaticResource IconGlyph}" FontSize="14" />
                                                        </Button>
                                                    </Grid>
                                                </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                            Visibility="{Binding HasVisibleTasks, Converter={StaticResource InverseBoolToVis}}">
                                    <Border Width="44" Height="44" CornerRadius="12" Background="#0FFFFFFF"
                                            BorderBrush="{DynamicResource CardBorder}" BorderThickness="1">
                                        <TextBlock Text="&#xE8FD;" FontFamily="{DynamicResource IconFont}" FontSize="18"
                                                   Foreground="{DynamicResource TextTertiary}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="这里还很空" FontSize="13" Foreground="{DynamicResource TextSecondary}"
                                               HorizontalAlignment="Center" Margin="0,12,0,0" />
                                    <TextBlock Text="写下一个任务；需要重启的，把勾打上。" FontSize="10.5"
                                               Foreground="{DynamicResource TextTertiary}"
                                               HorizontalAlignment="Center" Margin="0,4,0,0" />
                                </StackPanel>
                            </Grid>
                        </Grid>

                        <!-- 侧栏：状态合并 -->
                        <Border Grid.Column="1" Background="{DynamicResource PanelBg}"
                                BorderBrush="{DynamicResource CardBorder}" BorderThickness="1"
                                CornerRadius="12" Margin="0,6,0,4">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,3,0">
                                <StackPanel Margin="16,16,12,16">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="13" Height="13" Background="#FF0E1218" CornerRadius="7"
                                                    Padding="2" VerticalAlignment="Center" Margin="0,0,7,0"
                                                    Visibility="{Binding HasPending, Converter={StaticResource BoolToVis}}">
                                                <Ellipse Width="9" Height="9" Fill="{Binding PendingIndicatorBrush}" />
                                            </Border>
                                            <TextBlock Text="状态合并" Style="{StaticResource SectionTitle}" />
                                        </StackPanel>
                                        <Border HorizontalAlignment="Right" Background="{DynamicResource AccentSoft}"
                                                BorderBrush="{DynamicResource AccentBorder}" BorderThickness="1"
                                                CornerRadius="6" Padding="8,1">
                                            <TextBlock Text="{Binding PendingTotal}" FontSize="10"
                                                       Foreground="{DynamicResource Accent}" />
                                        </Border>
                                    </Grid>
                                    <TextBlock Text="{Binding PendingHeadline}" FontSize="11.5"
                                               Foreground="{DynamicResource TextPrimary}" Margin="0,8,0,0"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="按生效类型合并，凑够一批只中断一次。" Style="{StaticResource TinyText}"
                                               Margin="0,5,0,12" TextWrapping="Wrap" />

                                    <ItemsControl ItemsSource="{Binding PendingGroups}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource CardBg}"
                                                        BorderBrush="{DynamicResource CardBorder}" BorderThickness="1"
                                                        CornerRadius="10" Padding="12" Margin="0,0,0,8">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border Width="3" CornerRadius="2" Margin="0,2,8,2"
                                                                Background="{Binding Effect, Converter={StaticResource EffectBrush}}" />
                                                        <StackPanel Grid.Column="1">
                                                            <TextBlock Text="{Binding Title}" FontSize="11.5" FontWeight="SemiBold" />
                                                            <TextBlock Text="{Binding Prompt}" FontSize="10.5"
                                                                       Foreground="{DynamicResource TextSecondary}"
                                                                       TextWrapping="Wrap" Margin="0,6,0,0" />
                                                            <TextBlock Text="{Binding Preview}" FontSize="10"
                                                                       Foreground="{DynamicResource TextTertiary}"
                                                                       TextTrimming="CharacterEllipsis" Margin="0,6,0,0" />
                                                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                                                <Button Content="{Binding ActionText}" Tag="{Binding}"
                                                                        Style="{StaticResource PrimaryButton}"
                                                                        Padding="10,5" FontSize="10.5"
                                                                        Click="PowerAction_Click" />
                                                                <Button Content="标记已生效" Tag="{Binding}"
                                                                        Style="{StaticResource SubtleButton}"
                                                                        Margin="5,0,0,0" Padding="7,5"
                                                                        Click="MarkApplied_Click" />
                                                            </StackPanel>
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="2" Text="{Binding Count}" FontSize="20"
                                                                   FontWeight="Light" Margin="8,0,0,0" VerticalAlignment="Top"
                                                                   Foreground="{Binding Effect, Converter={StaticResource EffectBrush}}" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <Border Background="#08FFFFFF" BorderBrush="{DynamicResource CardBorder}"
                                            BorderThickness="1" CornerRadius="10" Padding="13"
                                            Visibility="{Binding HasPending, Converter={StaticResource InverseBoolToVis}}">
                                        <StackPanel>
                                            <TextBlock Text="暂无待生效任务" FontSize="11.5"
                                                       Foreground="{DynamicResource TextSecondary}" />
                                            <TextBlock Text="完成一个勾了「需要重启」的任务，它就会在这里排队。"
                                                       Style="{StaticResource TinyText}" TextWrapping="Wrap" Margin="0,5,0,0" />
                                        </StackPanel>
                                    </Border>

                                    <Border Background="{DynamicResource WarningSoft}"
                                            BorderBrush="{DynamicResource WarningBorder}" BorderThickness="1"
                                            CornerRadius="9" Padding="11" Margin="0,10,0,0"
                                            Visibility="{Binding HasNormalWarning, Converter={StaticResource BoolToVis}}">
                                        <StackPanel>
                                            <TextBlock Text="顺序提醒" FontSize="10" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource Warning}" />
                                            <TextBlock Text="{Binding NormalWarningText}" FontSize="10.5"
                                                       Foreground="{DynamicResource TextPrimary}"
                                                       TextWrapping="Wrap" Margin="0,4,0,0" />
                                            <Button Content="先做常规任务" Style="{StaticResource SubtleButton}"
                                                    HorizontalAlignment="Left" Margin="0,4,0,0"
                                                    Command="{Binding ShowNormalTasksCommand}" />
                                        </StackPanel>
                                    </Border>

                                    <Border Height="1" Background="{DynamicResource Divider}" Margin="0,16,0,13" />

                                    <TextBlock Text="下一步" Style="{StaticResource SectionTitle}" />
                                    <TextBlock Text="只列出没有被前置任务挡住的事项。" Style="{StaticResource TinyText}"
                                               Margin="0,5,0,10" TextWrapping="Wrap" />

                                    <ItemsControl ItemsSource="{Binding NextUp}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,9">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Ellipse Width="5" Height="5" VerticalAlignment="Center" Margin="1,0,9,0"
                                                             Fill="{Binding Effect, Converter={StaticResource EffectBrush}}" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="11"
                                                               TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextPrimary}" />
                                                    <TextBlock Grid.Column="2" Text="{Binding EffectLabel}" FontSize="9.5"
                                                               Foreground="{DynamicResource TextTertiary}" Margin="6,0,0,0" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock Text="没有可执行任务。"
                                               Style="{StaticResource TinyText}" Margin="0,0,0,8"
                                               Visibility="{Binding HasNextUp, Converter={StaticResource InverseBoolToVis}}" />

                                    <Border Height="1" Background="{DynamicResource Divider}" Margin="0,10,0,12" />

                                    <Grid>
                                        <TextBlock Text="上次生效" Style="{StaticResource TinyText}" />
                                        <TextBlock Text="{Binding LastAppliedText}" FontSize="9.5"
                                                   Foreground="{DynamicResource TextSecondary}"
                                                   HorizontalAlignment="Right" />
                                    </Grid>
                                    <TextBlock Text="关闭窗口后会继续留在托盘。" Style="{StaticResource TinyText}"
                                               Margin="0,10,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>

                    <!-- ===== 状态栏 ===== -->
                    <Border Grid.Row="2" BorderBrush="{DynamicResource Divider}" BorderThickness="0,1,0,0"
                            Background="#05000000">
                        <Grid Margin="20,0,18,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="5" Height="5" Fill="{DynamicResource Accent}" Margin="0,0,7,0" />
                                <TextBlock Text="手动模式" FontSize="9.5" Foreground="{DynamicResource TextSecondary}" />
                                <TextBlock Text="·" FontSize="9.5" Foreground="{DynamicResource TextTertiary}" Margin="8,0" />
                                <TextBlock Text="不读取系统状态" FontSize="9.5" Foreground="{DynamicResource TextTertiary}" />
                                <TextBlock Text="·" FontSize="9.5" Foreground="{DynamicResource TextTertiary}" Margin="8,0" />
                                <TextBlock Text="{Binding LastAppliedText, StringFormat=上次生效：{0}}"
                                           FontSize="9.5" Foreground="{DynamicResource TextTertiary}" />
                            </StackPanel>
                            <TextBlock Text="{Binding VersionText}" FontSize="9.5"
                                       Foreground="{DynamicResource TextTertiary}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </Grid>

                <!-- 提示条 -->
                <Border HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,42"
                        Panel.ZIndex="20" Background="#F2181E26"
                        BorderBrush="{DynamicResource AccentBorder}" BorderThickness="1"
                        CornerRadius="10" Padding="16,9"
                        Visibility="{Binding ToastVisible, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding ToastText}" FontSize="11" Foreground="{DynamicResource TextPrimary}" />
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
