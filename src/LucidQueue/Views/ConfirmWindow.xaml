<Window x:Class="LucidQueue.Views.ConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="确认" Width="470" SizeToContent="Height" MaxHeight="560"
        WindowStyle="None" Background="#FF0C0F15"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        FontFamily="{DynamicResource AppFont}">

    <Grid>
        <Border CornerRadius="0" BorderThickness="0" BorderBrush="#2AFFFFFF">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#FF161B24" Offset="0" />
                    <GradientStop Color="#FF0C0F15" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>

            <StackPanel Margin="22,20,22,18">
                <Grid MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <StackPanel Orientation="Horizontal">
                        <Border x:Name="AccentBar" Width="3" Height="16" CornerRadius="2"
                                Background="{DynamicResource Accent}" VerticalAlignment="Center" />
                        <TextBlock x:Name="TitleText" Text="确认" FontSize="13" FontWeight="SemiBold"
                                   Margin="9,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>

                <TextBlock x:Name="MessageText" FontSize="11.5" Foreground="{DynamicResource TextSecondary}"
                           TextWrapping="Wrap" LineHeight="19" Margin="0,14,0,0" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                    <Button x:Name="CancelButton" Content="取消" Style="{StaticResource GhostButton}"
                            Padding="16,8" Click="Cancel_Click" />
                    <Button x:Name="ConfirmButton" Content="确认" Style="{StaticResource PrimaryButton}"
                            Padding="18,8" Margin="8,0,0,0" Click="Confirm_Click" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
